        "\"\"\"\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "class ContinuousRV:\n",
        "    def __init__(self, cum_freq):\n",
        "        self.x = np.array(sorted(cum_freq.keys()), dtype=float)\n",
        "        self.F = np.array([cum_freq[k] for k in self.x], dtype=float)\n",
        "\n",
        "        if self.F[-1] != 1.0:\n",
        "            raise ValueError(\"CDF terakhir harus 1\")\n",
        "\n",
        "        self.pdf_grid = np.gradient(self.F, self.x)\n",
        "\n",
        "    def cdf(self, t):\n",
        "        return np.interp(t, self.x, self.F, left=0.0, right=1.0)\n",
        "\n",
        "    def pdf(self, t):\n",
        "        return np.interp(t, self.x, self.pdf_grid, left=0.0, right=0.0)\n",
        "\n",
        "    def ppf(self, u):\n",
        "        return np.interp(u, self.F, self.x)\n",
        "\n",
        "    def rvs(self, size=1, random_state=None):\n",
        "        rng = np.random.default_rng(random_state)\n",
        "        u = rng.random(size)\n",
        "        return self.ppf(u)\n",
        "\n",
        "    def mean(self):\n",
        "        return np.trapezoid(self.x * self.pdf_grid, self.x)\n",
        "\n",
        "    def var(self):\n",
        "        m = self.mean()\n",
        "        return np.trapezoid((self.x - m)**2 * self.pdf_grid, self.x)\n",
        "    \n",
        "cum_freq = {\n",
        "    500: 0.05,\n",
        "    600: 0.10,\n",
        "    700: 0.20,\n",
        "    800: 0.30,\n",
        "    900: 0.34,\n",
        "    1000: 0.55,\n",
        "    1100: 0.7,\n",
        "    1200: 1,\n",
        "}\n",
        "\n",
        "dist = ContinuousRV(cum_freq)\n",
        "\n",
        "print(\"CDF(2500) =\", dist.cdf(2500))\n",
        "print(\"PDF(2500) =\", dist.pdf(2500))\n",
        "print(\"PPF(0.5) =\", dist.ppf(0.5))\n",
        "\n",
        "samples = dist.rvs(size=10000, random_state=42)\n",
        "print(samples[:10])\n",
        "\n",
        "\n",
        "# Mean dan Var dari Teori\n",
        "print(\"Mean (integral):\", dist.mean())\n",
        "print(\"Var (integral):\", dist.var())\n",
        "\n",
        "# bandingkan dengan sampling\n",
        "samples = dist.rvs(100000, random_state=42)\n",
        "print(\"Mean (sampling):\", samples.mean())\n",
        "print(\"Var (sampling):\", samples.var())"

   "source": [
    "Berbeda beda yaitu: `{python} samples_1d[0]`\n",
    "\n",
    "1.  Generate data acak `numpy.random.normal`.\n",
    "2.  Tunjukkan aturan empiris: 68% data ada di $\\mu \\pm \\sigma$, 95% di $\\mu \\pm 2\\sigma$.\n",
    "3.  Visualisasi: Plot kurva lonceng dengan seaborn dan arsir area probabilitas. kita coba untuk 10000"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "68734e9c",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(array([   3,   51,  274, 1166, 2615, 3085, 2024,  647,  121,   14]),\n",
       " array([ 687.72414946,  727.85838652,  767.99262357,  808.12686062,\n",
       "         848.26109768,  888.39533473,  928.52957179,  968.66380884,\n",
       "        1008.79804589, 1048.93228295, 1089.06652   ]))"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "N= 10000\n",
    "\n",
    "data = rng.normal(loc=mu, scale=sigma, size=N)\n",
    "np.histogram(data, bins=10)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7dd43a15",
   "metadata": {},
   "source": [
    "Kita hitung berapa data antara 1. $850< X < 950$ 2. $800<  X < 1000$ 3. $750 < X <1050$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "2f03d7a6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.6892 0.957 0.9975\n"
     ]
    }
   ],
   "source": [
    "counter1=0\n",
    "counter2=0\n",
    "counter3=0\n",
    "for n in data:\n",
    "    if n >= 850 and n < 950:\n",
    "        counter1 += 1  \n",
    "    elif n >= 800 and n < 1000:\n",
    "        counter2 += 1\n",
    "    elif n >= 750 and n < 1050:\n",
    "        counter3 += 1\n",
    "\n",
    "print(counter1/N, (counter1+counter2)/N, (counter1+counter2+counter3)/N)"
   ]
  },

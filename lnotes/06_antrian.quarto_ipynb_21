    "---\n",
    "title: \"Pemodelan Antrian: Sebuah Studi Kasus Pengubah Acak Diskrit\"\n",
    "subtitle: \"Catatan Kuliah Probabilitas dan Statistika\"  \n",
    "bibliography: ref.bib \n",
    "format:\n",
    "    typst:\n",
    "        keep-typ: true\n",

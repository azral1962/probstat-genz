    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "mu = 10000\n",
        "sigma = 1000\n",
        "\n",
        "p = norm.cdf(8000, mu, sigma)\n",
        "p_aman = 0.95\n",

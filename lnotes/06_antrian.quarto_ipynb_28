        "    # Data:\n",
        "    # rata-rata 400 orang/hari\n",
        "    # jam kerja 8 jam => 50 orang/jam\n",
        "    model = PoissonQueueHourModel(\n",
        "        arrival_rate_per_hour=400 / 8,\n",
        "        service_rate_per_hour=400 / 8,\n",
        "        waiting_capacity=10\n",

        "        print(f\"{k}: {v}\")\n",
        "\n",
        "    # Simulasi untuk verifikasi\n",
        "    sim = model.simulate(n_sim=200_000, random_seed=42)\n",
        "    print(\"\\n=== HASIL SIMULASI ===\")\n",
        "    print(f\"Prob. queue (simulasi)    : {sim['prob_queue_sim']:.4f}\")\n",

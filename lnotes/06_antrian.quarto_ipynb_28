        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import poisson\n",
        "\n",
        "\n",
        "class PoissonQueueHourModel:\n",
        "    \"\"\"\n",
        "    Model sederhana untuk 1 interval waktu (mis. 1 jam),\n",
        "    dengan:\n",
        "      - jumlah kedatangan ~ Poisson(arrival_rate)\n",
        "      - jumlah pelayanan selesai ~ Poisson(service_rate)\n",
        "\n",
        "    Queue muncul bila arrivals > services.\n",
        "    Overflow terjadi bila arrivals - services > waiting_capacity.\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, arrival_rate_per_hour, service_rate_per_hour, waiting_capacity=10):\n",
        "        self.lambda_arrival = arrival_rate_per_hour\n",
        "        self.lambda_service = service_rate_per_hour\n",
        "        self.waiting_capacity = waiting_capacity\n",
        "\n",
        "    def pmf_arrivals(self, k):\n",
        "        return poisson.pmf(k, self.lambda_arrival)\n",
        "\n",
        "    def pmf_services(self, k):\n",
        "        return poisson.pmf(k, self.lambda_service)\n",
        "\n",
        "    def exact_prob_queue(self, max_k=None):\n",
        "        \"\"\"\n",
        "        Hitung P(A > S) secara eksak diskret.\n",
        "        \"\"\"\n",
        "        if max_k is None:\n",
        "            max_k = int(max(self.lambda_arrival, self.lambda_service) + 6 * np.sqrt(max(self.lambda_arrival, self.lambda_service)))\n",
        "\n",
        "        a_vals = np.arange(0, max_k + 1)\n",
        "        s_vals = np.arange(0, max_k + 1)\n",
        "\n",
        "        p_a = poisson.pmf(a_vals, self.lambda_arrival)\n",
        "        p_s = poisson.pmf(s_vals, self.lambda_service)\n",
        "\n",
        "        prob = 0.0\n",
        "        for i, a in enumerate(a_vals):\n",
        "            # jumlahkan probabilitas semua s < a\n",
        "            prob += p_a[i] * p_s[s_vals < a].sum()\n",
        "        return prob\n",
        "\n",
        "    def exact_prob_overflow(self, max_k=None):\n",
        "        \"\"\"\n",
        "        Hitung P(A - S > waiting_capacity) secara eksak diskret.\n",
        "        \"\"\"\n",
        "        if max_k is None:\n",
        "            max_k = int(max(self.lambda_arrival, self.lambda_service) + 6 * np.sqrt(max(self.lambda_arrival, self.lambda_service)))\n",
        "\n",
        "        a_vals = np.arange(0, max_k + 1)\n",
        "        s_vals = np.arange(0, max_k + 1)\n",
        "\n",
        "        p_a = poisson.pmf(a_vals, self.lambda_arrival)\n",
        "        p_s = poisson.pmf(s_vals, self.lambda_service)\n",
        "\n",
        "        cap = self.waiting_capacity\n",
        "        prob = 0.0\n",
        "        for i, a in enumerate(a_vals):\n",
        "            prob += p_a[i] * p_s[s_vals < (a - cap)].sum()\n",
        "        return prob\n",
        "\n",
        "    def simulate(self, n_sim=100_000, random_seed=123):\n",
        "        \"\"\"\n",
        "        Simulasi Monte Carlo.\n",
        "        \"\"\"\n",
        "        rng = np.random.default_rng(random_seed)\n",
        "        arrivals = rng.poisson(self.lambda_arrival, size=n_sim)\n",
        "        services = rng.poisson(self.lambda_service, size=n_sim)\n",
        "        backlog = arrivals - services\n",
        "\n",
        "        result = {\n",
        "            \"arrivals\": arrivals,\n",
        "            \"services\": services,\n",
        "            \"backlog\": backlog,\n",
        "            \"prob_queue_sim\": np.mean(backlog > 0),\n",
        "            \"prob_overflow_sim\": np.mean(backlog > self.waiting_capacity),\n",
        "        }\n",
        "        return result\n",
        "\n",
        "    def summary(self):\n",
        "        pq = self.exact_prob_queue()\n",
        "        po = self.exact_prob_overflow()\n",
        "        return {\n",
        "            \"arrival_rate_per_hour\": self.lambda_arrival,\n",
        "            \"service_rate_per_hour\": self.lambda_service,\n",
        "            \"waiting_capacity\": self.waiting_capacity,\n",
        "            \"prob_queue_exact\": pq,\n",
        "            \"prob_overflow_exact\": po,\n",
        "        }\n",
        "\n",
        "    def plot_poisson_distributions(self, max_k=None):\n",
        "        \"\"\"\n",
        "        Plot distribusi jumlah kedatangan dan pelayanan.\n",
        "        \"\"\"\n",
        "        if max_k is None:\n",
        "            max_k = int(max(self.lambda_arrival, self.lambda_service) + 4 * np.sqrt(max(self.lambda_arrival, self.lambda_service)))\n",
        "\n",
        "        k = np.arange(0, max_k + 1)\n",
        "        p_a = poisson.pmf(k, self.lambda_arrival)\n",
        "        p_s = poisson.pmf(k, self.lambda_service)\n",
        "\n",
        "        plt.figure(figsize=(10, 5))\n",
        "        plt.plot(k, p_a, marker='o', label=f'Arrivals ~ Poisson({self.lambda_arrival:.1f})')\n",
        "        plt.plot(k, p_s, marker='s', label=f'Services ~ Poisson({self.lambda_service:.1f})')\n",
        "        plt.title('Distribusi Kedatangan dan Pelayanan per Jam')\n",
        "        plt.xlabel('Jumlah orang')\n",
        "        plt.ylabel('Probabilitas')\n",
        "        plt.grid(True, alpha=0.3)\n",
        "        plt.legend()\n",
        "        plt.show()\n",
        "\n",
        "    def plot_backlog_histogram(self, n_sim=100_000, random_seed=123):\n",
        "        \"\"\"\n",
        "        Plot histogram backlog = arrivals - services.\n",
        "        \"\"\"\n",
        "        sim = self.simulate(n_sim=n_sim, random_seed=random_seed)\n",
        "        backlog = sim[\"backlog\"]\n",
        "\n",
        "        min_x = min(backlog.min(), -20)\n",
        "        max_x = max(backlog.max(), 20)\n",
        "        bins = np.arange(min_x - 0.5, max_x + 1.5, 1)\n",
        "\n",
        "        plt.figure(figsize=(10, 5))\n",
        "        plt.hist(backlog, bins=bins, density=True, alpha=0.75, edgecolor='black')\n",
        "        plt.axvline(0.5, linestyle='--', label='Batas mulai antrian (>0)')\n",
        "        plt.axvline(self.waiting_capacity + 0.5, linestyle='--',\n",
        "                    label=f'Batas luber (>{self.waiting_capacity})')\n",
        "        plt.title('Histogram Selisih (Arrivals - Services)')\n",
        "        plt.xlabel('Backlog')\n",
        "        plt.ylabel('Frekuensi relatif')\n",
        "        plt.grid(True, alpha=0.3)\n",
        "        plt.legend()\n",
        "        plt.show()\n",
        "\n",
        "    def plot_queue_risk_curve(self, max_capacity=30, max_k=None):\n",
        "        \"\"\"\n",
        "        Plot peluang overflow untuk berbagai kapasitas ruang tunggu.\n",
        "        \"\"\"\n",
        "        capacities = np.arange(0, max_capacity + 1)\n",
        "        probs = []\n",
        "\n",
        "        old_cap = self.waiting_capacity\n",
        "        for cap in capacities:\n",
        "            self.waiting_capacity = cap\n",
        "            probs.append(self.exact_prob_overflow(max_k=max_k))\n",
        "        self.waiting_capacity = old_cap\n",
        "\n",
        "        plt.figure(figsize=(10, 5))\n",
        "        plt.plot(capacities, probs, marker='o')\n",
        "        plt.title('Peluang Luber vs Kapasitas Ruang Tunggu')\n",
        "        plt.xlabel('Kapasitas kursi tunggu')\n",
        "        plt.ylabel('P(luber)')\n",
        "        plt.grid(True, alpha=0.3)\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "# =========================\n",
        "# DEMO PAKAI DATA SOAL\n",
        "# =========================\n",
        "\n",

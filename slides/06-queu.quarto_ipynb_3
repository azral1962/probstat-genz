      "cell_type": "code",
      "metadata": {},
      "source": [
        "def calc_variance(values, probs):  \n",
        "    ex = sum(v * p for v, p in zip(values, probs))  \n",
        "    ex2 = sum((v**2) * p for v, p in zip(values, probs))  \n",
        "    return ex2 - ex**2  "

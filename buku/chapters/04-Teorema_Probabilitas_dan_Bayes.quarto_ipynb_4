        "### 00:50–01:00 | Pod Formation & Mission Brief: “Building a Naive Spam Filter”\n",
        "\n",
        "Kode “starter” yang bisa jadi tugas GitHub: parsing email sederhana + skor kata kunci.\n",
        "\n",
        "```python\n",
        "import re\n",
        "from collections import Counter\n",
        "\n",
        "def tokenize(text):\n",
        "    # Lowercase + ambil kata\n",
        "    return re.findall(r\"[a-zA-Z0-9]+\", text.lower())\n",
        "\n",
        "def train_keyword_model(emails, labels):\n",
        "    \"\"\"\n",
        "    emails: list[str]\n",
        "    labels: list[int]  # 1 spam, 0 ham\n",
        "    return counts kata per kelas + prior\n",
        "    \"\"\"\n",
        "    spam_words = Counter()\n",
        "    ham_words = Counter()\n",
        "    n_spam = 0\n",
        "    n_ham = 0\n",
        "\n",
        "    for text, y in zip(emails, labels):\n",
        "        words = tokenize(text)\n",
        "        if y == 1:\n",
        "            n_spam += 1\n",
        "            spam_words.update(words)\n",
        "        else:\n",
        "            n_ham += 1\n",
        "            ham_words.update(words)\n",
        "\n",
        "    prior_spam = n_spam / (n_spam + n_ham) if (n_spam + n_ham) else 0.0\n",
        "    return {\"spam_words\": spam_words, \"ham_words\": ham_words, \"prior_spam\": prior_spam}\n",
        "\n",
        "def predict_naive_keyword(text, model, keywords=(\"gratis\", \"promo\", \"diskon\"), threshold=1):\n",
        "    \"\"\"\n",
        "    SANGAT naive: jika jumlah keyword muncul >= threshold => spam\n",
        "    \"\"\"\n",
        "    words = tokenize(text)\n",
        "    c = Counter(words)\n",
        "    score = sum(c[k] for k in keywords)\n",
        "    return 1 if score >= threshold else 0, score\n",
        "\n",
        "# Demo mini\n",
        "emails = [\n",
        "    \"Gratis diskon besar untuk kamu!\",\n",
        "    \"Rapat jam 10, jangan lupa agenda\",\n",
        "    \"Promo terbatas! gratis ongkir\",\n",
        "    \"Tolong kirim laporan minggu ini\"\n",
        "]\n",
        "labels = [1, 0, 1, 0]\n",
        "\n",
        "model = train_keyword_model(emails, labels)\n",
        "print(\"Prior spam:\", model[\"prior_spam\"])\n",
        "\n",
        "for e in emails:\n",
        "    yhat, score = predict_naive_keyword(e, model)\n",
        "    print(yhat, score, \"=>\", e)\n",
        "```\n",

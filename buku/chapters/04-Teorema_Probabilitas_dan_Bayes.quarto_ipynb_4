        "def bayes_posterior(p_terrorist=1/10_000, sensitivity=0.99, false_positive_rate=0.01):\n",
        "    \"\"\"\n",
        "    P(T|+) = P(+|T)P(T) / (P(+|T)P(T) + P(+|~T)P(~T))\n",
        "    sensitivity = P(+|T)\n",
        "    false_positive_rate = P(+|~T)\n",
        "    \"\"\"\n",
        "    p_t = p_terrorist\n",
        "    p_not = 1 - p_t\n",
        "    p_pos_given_t = sensitivity\n",
        "    p_pos_given_not = false_positive_rate\n",
        "\n",
        "    numerator = p_pos_given_t * p_t\n",
        "    denominator = numerator + p_pos_given_not * p_not\n",
        "    return numerator / denominator\n",
        "\n",
        "posterior = bayes_posterior(p_terrorist=1/10_000, sensitivity=0.99, false_positive_rate=0.01)\n",
        "print(f\"P(teroris | alarm berbunyi) = {posterior:.6f} = {posterior*100:.4f}%\")"

        "def bayes_theorem(prior, likelihood, neg_likelihood):\n",
        "    numerator = likelihood * prior\n",
        "    denominator = (likelihood * prior) + (neg_likelihood * (1 - prior))\n",
        "    return (numerator / denominator) * 100\n",
        "\n",

        "```python\n",
        "# 0 = Bukan Spam (Ham), 1 = Spam\n",
        "data_latih = [\n",
        "    (\"Halo apa kabar hari ini\", 0),\n",
        "    (\"Rapat dosen jam sepuluh pagi\", 0),\n",

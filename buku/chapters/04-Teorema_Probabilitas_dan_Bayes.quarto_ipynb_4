        "### 00:30–00:50 | Konsep: Teorema Bayes + Independen vs Saling Lepas\n",
        "\n",
        "#### A) Bayes sebagai “update engine”\n",
        "\n",
        "```python\n",
        "def bayes_update(prior, likelihood_pos_given_H, likelihood_pos_given_notH):\n",
        "    \"\"\"\n",
        "    prior = P(H)\n",
        "    likelihood_pos_given_H = P(+|H)\n",
        "    likelihood_pos_given_notH = P(+|~H)\n",
        "    returns posterior P(H|+)\n",
        "    \"\"\"\n",
        "    pH = prior\n",
        "    pNot = 1 - pH\n",
        "    num = likelihood_pos_given_H * pH\n",
        "    den = num + likelihood_pos_given_notH * pNot\n",
        "    return num / den\n",
        "\n",
        "prior = 1/10_000\n",
        "posterior = bayes_update(prior, likelihood_pos_given_H=0.99, likelihood_pos_given_notH=0.01)\n",
        "print(\"Posterior:\", posterior, \"=\", posterior*100, \"%\")\n",
        "```\n",
        "\n",
        "#### B) Demo “Independen vs Mutually Exclusive” (pakai angka sederhana)\n",
        "\n",
        "```python\n",
        "def check_independent(pA, pB, pA_and_B, tol=1e-9):\n",
        "    return abs(pA_and_B - (pA * pB)) < tol\n",
        "\n",
        "def check_mutually_exclusive(pA_and_B, tol=1e-9):\n",
        "    return abs(pA_and_B - 0.0) < tol\n",
        "\n",
        "# Contoh 1: Independen (koin & dadu)\n",
        "pA = 1/2          # koin = head\n",
        "pB = 1/6          # dadu = 6\n",
        "pA_and_B = 1/12   # head AND 6\n",
        "print(\"Independen?\", check_independent(pA, pB, pA_and_B))\n",
        "print(\"Saling Lepas?\", check_mutually_exclusive(pA_and_B))\n",
        "\n",
        "# Contoh 2: Saling Lepas (dadu = 1 vs dadu = 2)\n",
        "pA = 1/6          # dadu = 1\n",
        "pB = 1/6          # dadu = 2\n",
        "pA_and_B = 0      # tidak mungkin terjadi bersamaan\n",
        "print(\"Independen?\", check_independent(pA, pB, pA_and_B))   # biasanya False\n",
        "print(\"Saling Lepas?\", check_mutually_exclusive(pA_and_B)) # True\n",
        "```\n",
